# Local application
APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATA_DIR=./data
CAREERMOVE_SCHEMA_ON_START=1
CAREERMOVE_LOCAL_DEMO=1
CAREERMOVE_API_SECRET=
DATABASE_URL=

# Optional AI reranking. Deterministic ranking works without these keys.
OPEN_MODEL_PROVIDER=ensemble
AI_MAX_PROVIDERS=3
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Optional scheduled search and notifications
CRON_SECRET=
TELEGRAM_BOT_TOKEN=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:owner@example.com
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=CareerMove <jobs@example.com>

# Optional server-side public-feed proxy
SEARCH_PROXY_URL=
SEARCH_PROXY_DIRECT_FALLBACK=1

# Optional GitHub Actions worker
SEARCH_EXECUTION_MODE=background
GITHUB_SEARCH_REPOSITORY=your-github-account/careermove-showcase
GITHUB_SEARCH_WORKFLOW=daily-search.yml
GITHUB_SEARCH_REF=main
GITHUB_SEARCH_TOKEN=

# Administrative boundary
CAREERMOVE_OWNER_EMAIL=owner@example.com
ADMIN_EMAILS=owner@example.com
